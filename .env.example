# Root `.env` — read by Vite's dev/build (web app only).
# `apps/web/vite.config.ts` sets `envDir` to the monorepo root so the
# web app doesn't need its own duplicate. Server-side env lives in
# `apps/server/.env` (see `apps/server/.env.example`).
#
# Only `VITE_*` keys leak into the client bundle. Everything else here
# stays in the dev-server process and is safe.

# Frontend Supabase (same project as the server)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Where the SPA hits the API.
# - Dev:  leave empty → Vite dev proxy forwards /chat, /briefs, etc.
#         to VITE_DEV_API_TARGET (default http://localhost:3001)
# - Prod: set to the deployed apps/server origin
VITE_API_BASE_URL=

# Optional override for the dev proxy target (rarely needed)
# VITE_DEV_API_TARGET=http://localhost:3001

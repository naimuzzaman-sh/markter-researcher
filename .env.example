# Public origin of the web app — used to build the /authorize/<userCode> URL
# returned by POST /auth/device/start. Must match the URL the user's browser hits.
# - Dev:   Vite serves the web on :5173, NestJS serves the API on :3000 → use :5173 here.
# - Prod:  NestJS also serves the built web alongside the API on one origin → use that origin.
APP_BASE_URL=http://localhost:5173

# Frontend (Vite) — same Supabase project as above, but read at build time by the React app.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

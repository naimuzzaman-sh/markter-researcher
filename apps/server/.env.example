PORT=3001
NODE_ENV=development

# CORS allow-list (comma-separated origins)
WEB_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Google Gemini — for chat agent + brief analysis
GEMINI_API_KEY=AIza...

# Network-lens discovery (Exa search + OpenAI embeddings)
EXA_API_KEY=exa_...
OPENAI_API_KEY=sk-...

# ElevenLabs Convai — voice interviews
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
ELEVENLABS_WEBHOOK_SECRET=

# Resend — outbound transactional email (interview invites)
# RESEND_API_KEY: from https://resend.com/api-keys
# RESEND_FROM_EMAIL: must be on a verified domain in Resend
# RESEND_WEBHOOK_SECRET: optional in dev; required in prod for the
# bounce/complaint handler at POST /webhooks/resend. Configure under
# Resend dashboard → Webhooks → Add endpoint and copy the `whsec_…`
# value. Subscribe to: email.delivered, email.bounced, email.complained.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=research@yourdomain.com
RESEND_WEBHOOK_SECRET=
